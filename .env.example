# ============================================
# Variáveis de ambiente do Petto
# Copie este arquivo para `.env` e preencha os valores:
#   cp .env.example .env
# ============================================

# Ambiente da aplicação (development | staging | production)
APP_ENV=development

# URL base da API do Petto (usada nas integrações futuras)
API_BASE_URL=https://api.petto.example.com

# Chave da API do Google (Maps / Places)
GOOGLE_API_KEY=
